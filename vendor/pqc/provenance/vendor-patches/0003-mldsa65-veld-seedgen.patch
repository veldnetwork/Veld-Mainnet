diff --git a/vendor/pqc/mldsa65/veld_seedgen.c b/vendor/pqc/mldsa65/veld_seedgen.c
new file mode 100644
--- /dev/null
+++ b/vendor/pqc/mldsa65/veld_seedgen.c
@@ -0,0 +1,64 @@
+/*
+ * Veld addition to PQClean ML-DSA-65: deterministic keygen from a 32-byte seed.
+ *
+ * Mirrors PQCLEAN_MLDSA65_CLEAN_crypto_sign_keypair (sign.c) verbatim, except
+ * the 32-byte root seed comes from the caller instead of randombytes(). This
+ * lets Veld use a 32-byte seed as the canonical wallet-level "private key":
+ * the full 4032-byte ML-DSA secret key is reconstructed from the seed on
+ * demand, so wallets can continue to store / import / encrypt compact 32-byte
+ * secrets (same UX as the secp256k1 era) while the crypto underneath is
+ * post-quantum.
+ *
+ * The derivation is byte-for-byte identical to what crypto_sign_keypair would
+ * have produced if randombytes had returned `seed` — just externalises the
+ * randomness source.
+ */
+#include "fips202.h"
+#include "packing.h"
+#include "params.h"
+#include "poly.h"
+#include "polyvec.h"
+#include "symmetric.h"
+#include <stdint.h>
+#include <string.h>
+
+int veld_mldsa65_keypair_from_seed(const uint8_t seed[SEEDBYTES],
+                                   uint8_t *pk, uint8_t *sk) {
+    uint8_t seedbuf[2 * SEEDBYTES + CRHBYTES];
+    uint8_t tr[TRBYTES];
+    const uint8_t *rho, *rhoprime, *key;
+    polyvecl mat[K];
+    polyvecl s1, s1hat;
+    polyveck s2, t1, t0;
+
+    /* Seed comes from caller */
+    memcpy(seedbuf, seed, SEEDBYTES);
+    seedbuf[SEEDBYTES + 0] = K;
+    seedbuf[SEEDBYTES + 1] = L;
+    shake256(seedbuf, 2 * SEEDBYTES + CRHBYTES, seedbuf, SEEDBYTES + 2);
+    rho = seedbuf;
+    rhoprime = rho + SEEDBYTES;
+    key = rhoprime + CRHBYTES;
+
+    PQCLEAN_MLDSA65_CLEAN_polyvec_matrix_expand(mat, rho);
+
+    PQCLEAN_MLDSA65_CLEAN_polyvecl_uniform_eta(&s1, rhoprime, 0);
+    PQCLEAN_MLDSA65_CLEAN_polyveck_uniform_eta(&s2, rhoprime, L);
+
+    s1hat = s1;
+    PQCLEAN_MLDSA65_CLEAN_polyvecl_ntt(&s1hat);
+    PQCLEAN_MLDSA65_CLEAN_polyvec_matrix_pointwise_montgomery(&t1, mat, &s1hat);
+    PQCLEAN_MLDSA65_CLEAN_polyveck_reduce(&t1);
+    PQCLEAN_MLDSA65_CLEAN_polyveck_invntt_tomont(&t1);
+
+    PQCLEAN_MLDSA65_CLEAN_polyveck_add(&t1, &t1, &s2);
+
+    PQCLEAN_MLDSA65_CLEAN_polyveck_caddq(&t1);
+    PQCLEAN_MLDSA65_CLEAN_polyveck_power2round(&t1, &t0, &t1);
+    PQCLEAN_MLDSA65_CLEAN_pack_pk(pk, rho, &t1);
+
+    shake256(tr, TRBYTES, pk, PQCLEAN_MLDSA65_CLEAN_CRYPTO_PUBLICKEYBYTES);
+    PQCLEAN_MLDSA65_CLEAN_pack_sk(sk, rho, tr, key, &t0, &s1, &s2);
+
+    return 0;
+}
