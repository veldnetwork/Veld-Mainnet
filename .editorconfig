root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{sh,yml,yaml,json}]
indent_size = 2

[*.bat]
end_of_line = crlf

[*.md]
trim_trailing_whitespace = false

[{vendor/**,include/crypto/vendored*.h,include/crypto/mldsa65_nist_kat.h,include/network/*_js.h}]
charset = unset
end_of_line = unset
insert_final_newline = unset
trim_trailing_whitespace = unset
indent_style = unset
indent_size = unset
